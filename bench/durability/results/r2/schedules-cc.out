# six --count f1
mode=round N=6 FMAX=2 MAXOS=4 MAXP=1 MAXT=5 depth 10 base=[0, 1, 2, 3, 4, 5] script=remove:2 count=f1
   1. elect 4 term 1 votes from [0, 1, 2]
   2. replicate 4->0
   3. replicate 4->1
   4. replicate 4->2
   5. replicate 4->3
   6. replicate 4->5
   7. sync 0
   8. sync 1
   9. sync 2
  10. sync 3
  11. sync 4
  12. sync 5
  13. replicate 4->0
  14. replicate 4->1
  15. replicate 4->2
  16. replicate 4->3
  17. replicate 4->5
  18. commit at 4: memory 1, durable 1
  19. write v0 at 4 term 1
  20. replicate 4->5
  21. replicate 4->0
  22. replicate 4->1
  23. commit at 4: memory 2, durable 1
  24. remove 2 at 4 term 1
  25. sync 4
  26. replicate 4->5
  27. sync 5
  28. os-crash 0 (keeps 1 synced entries)
  29. os-crash 2 (keeps 1 synced entries)
  30. probe 2->0
  31. replicate 4->2
  32. os-crash 1 (keeps 1 synced entries)
  33. probe 1->0
  34. round 0 term 2
  35. ask 0->1 granted forgetful
  36. ask 0->3 granted
  37. fail-elect 5 term 2 reaching [4]
  38. elect 5 term 3 votes from [3, 4]
  39. replicate 5->1
  40. os-crash 2 (keeps 1 synced entries)
  41. ask 0->2 granted forgetful
  42. recovery_timeout 0
  43. decide 0 term 2 (4 grants, 3 forgetful)   <- memory
  result: memory; at most 2 voters forgetful at once

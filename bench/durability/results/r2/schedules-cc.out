# restart3 --restart text
mode=round N=3 FMAX=1 MAXOS=2 MAXP=1 MAXT=2 depth 10 restart=text maxr=1
   1. elect 0 term 1 votes from [1]
   2. write v0 at 0 term 1
   3. replicate 0->1
   4. commit at 0: memory 2, durable 0
   5. os-crash 0 (keeps 0 synced entries)
   6. process-restart 0
   7. elect 0 term 2 votes from [2]   <- memory
  result: memory; at most 1 voters forgetful at once
# restart3 --restart persist
mode=round N=3 FMAX=1 MAXOS=2 MAXP=1 MAXT=2 depth 10 restart=persist maxr=1
   1. elect 0 term 1 votes from [1]
   2. write v0 at 0 term 1
   3. replicate 0->1
   4. commit at 0: memory 2, durable 0
   5. os-crash 0 (keeps 0 synced entries)
  step 6: 'process-restart 0' is not enabled here
# restart3p --restart text
mode=round N=3 FMAX=1 MAXOS=2 MAXP=1 MAXT=2 depth 10 restart=text maxr=1
   1. elect 0 term 1 votes from [1]
   2. write v0 at 0 term 1
   3. replicate 0->1
   4. commit at 0: memory 2, durable 0
   5. os-crash 0 (keeps 0 synced entries)
  step 6: 'process-restart 0 forgetful' is not enabled here

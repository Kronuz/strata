# Runs `RUN SEED` twice, in two processes, and fails unless both write the same history and
# print the same summary (the run's trace hash among it): one seed, one history.
foreach(i 1 2)
  execute_process(COMMAND "${RUN}" --history "${OUT}.${i}" "${SEED}" RESULT_VARIABLE status OUTPUT_VARIABLE summary_${i})
  if(NOT status EQUAL 0)
    message(FATAL_ERROR "run ${i} of seed ${SEED} exited ${status}: ${summary_${i}}")
  endif()
  file(SHA256 "${OUT}.${i}" digest_${i})
  file(SIZE "${OUT}.${i}" size_${i})
endforeach()
if(NOT summary_1 STREQUAL summary_2)
  message(FATAL_ERROR "seed ${SEED} printed two summaries:\n${summary_1}${summary_2}")
endif()
if(NOT digest_1 STREQUAL digest_2)
  message(FATAL_ERROR "seed ${SEED} wrote two histories: ${digest_1} (${size_1} bytes) and ${digest_2} (${size_2} bytes)")
endif()
if(size_1 LESS 100000)
  message(FATAL_ERROR "seed ${SEED} wrote only ${size_1} bytes of history")
endif()
message(STATUS "seed ${SEED}: two runs, one history, ${size_1} bytes, sha256 ${digest_1}\n${summary_1}")

# strata layers. Render: d2 --layout elk --sketch --theme 302 docs/strata.d2 docs/strata.svg
# Render: d2 docs/strata.d2 docs/strata.svg
vars: { d2-config: { layout-engine: elk; theme-id: 302; sketch: true; pad: 24; theme-overrides: { B1: "#8C7B7E"; B2: "#C25B73"; N2: "#C25B73" } } }
style.fill: transparent

direction: down
xapiand: "Xapiand / Elysian\nHTTP · schema · routing · coordinator"
group: "strata::group\none replication group per shard"
prospect: "prospect (search layout)\nterms · postings · scoring · queries"
core: "strata core\nIndex · Segment · Manifest · Merge · keys · stored"
repl: "consensus · journal\nreplicated log"
libs: "building blocks: task · residency · termdict · fst · fusefilter · compressors · completion · threadpool"
xapiand -> group
xapiand -> prospect
group -> core
group -> repl
prospect -> core
core -> libs

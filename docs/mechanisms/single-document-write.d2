vars: { d2-config: { layout-engine: elk; theme-id: 302; sketch: true; pad: 24; theme-overrides: { B1: "#8C7B7E"; B2: "#C25B73"; N2: "#C25B73" } } }
style.fill: transparent

direction: right

a: "active buffer\ndocid map" { style.fill: "#F4F1EA" }
f: "frozen buffers\nnewest first" { style.fill: "#F4F1EA" }
s: "segments\nnewest first" { style.fill: "#F4F1EA" }
v: "first live hit\nanswers" { style.fill: "#FBE3C8" }
a -> f: "miss"
f -> s: "miss"
s -> v
